#!/bin/sh
# Maven Wrapper - downloads and runs maven
set -e
MAVEN_PROJECTBASEDIR="${MAVEN_BASEDIR:-$(cd "$(dirname "$0")" && pwd)}"
MAVEN_WRAPPER_PROPERTIES_FILE="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.properties"
if [ -f "$MAVEN_WRAPPER_PROPERTIES_FILE" ]; then
    DISTRIBUTION_URL=$(grep 'distributionUrl' "$MAVEN_WRAPPER_PROPERTIES_FILE" | cut -d'=' -f2-)
fi
DISTRIBUTION_URL="${DISTRIBUTION_URL:-https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/3.9.8/apache-maven-3.9.8-bin.zip}"
MAVEN_HOME="$HOME/.m2/wrapper/dists/$(basename "$DISTRIBUTION_URL" .zip)"
if [ ! -d "$MAVEN_HOME" ]; then
    mkdir -p "$MAVEN_HOME"
    echo "Downloading Maven from $DISTRIBUTION_URL"
    if command -v curl > /dev/null; then
        curl -fsSL "$DISTRIBUTION_URL" -o "/tmp/maven.zip"
    elif command -v wget > /dev/null; then
        wget -q "$DISTRIBUTION_URL" -O "/tmp/maven.zip"
    fi
    unzip -qo "/tmp/maven.zip" -d "$MAVEN_HOME"
    rm -f "/tmp/maven.zip"
fi
MVN_CMD="$(find "$MAVEN_HOME" -name 'mvn' -path '*/bin/mvn' | head -1)"
exec "$MVN_CMD" "$@"
