# ============================================================
# TaskForge — Environment Variables Example
# Copy this to .env and fill in PG_PASSWORD.
# ============================================================

# ---- Supabase PostgreSQL (single DB, shared by all services) ----
PG_HOST=aws-0-ap-south-1.pooler.supabase.com
PG_PORT=5432
PG_DATABASE=postgres
PG_USER=postgres.fhkuaarhrafeegrgffbg
PG_PASSWORD=YOUR_SUPABASE_PASSWORD_HERE

# ---- Redis (gateway pub/sub) ----
REDIS_URL=YOUR_UPSTASH_URL

# ---- Internal service URLs (used by docker-compose networking) ----
JWKS_URL=http://auth-service:8080/.well-known/jwks.json
AUTH_SERVICE_URL=http://auth-service:8080
CORE_SERVICE_URL=http://core-service:8081
SEARCH_SERVICE_URL=http://search-service:8000
GATEWAY_NOTIFY_URL=http://gateway:4000/internal/notify

# ---- Frontend ----
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql
NEXT_PUBLIC_WS_URL=ws://localhost:4000/graphql
NEXT_PUBLIC_GATEWAY_URL=http://localhost:4000
