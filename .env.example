# ============================================================
# TaskForge — Environment Variables Example
# Copy this to .env and fill in PG_PASSWORD.
# ============================================================

# ---- Supabase PostgreSQL (single DB, shared by all services) ----
PG_HOST=aws-0-ap-south-1.pooler.supabase.com
PG_PORT=5432
PG_DATABASE=postgres
PG_USER=postgres.fhkuaarhrafeegrgffbg
PG_PASSWORD=YOUR_SUPABASE_PASSWORD_HERE

# ---- Redis (gateway pub/sub) ----
REDIS_URL=YOUR_UPSTASH_URL
# For local Docker Redis with password: redis://:${REDIS_PASSWORD}@redis:6379
REDIS_PASSWORD=your_local_redis_password_here  # generate: openssl rand -hex 16

# ---- Internal service URLs (used by docker-compose networking) ----
JWKS_URL=http://auth-service:8080/.well-known/jwks.json
AUTH_SERVICE_URL=http://auth-service:8080
CORE_SERVICE_URL=http://core-service:8081
EXTERNAL_SERVICES_URL=http://external-services:8000
GATEWAY_NOTIFY_URL=http://gateway:4000/internal/notify

# ---- Frontend ----
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql
NEXT_PUBLIC_WS_URL=ws://localhost:4000/graphql
NEXT_PUBLIC_GATEWAY_URL=http://localhost:4000

# ---- Mail (Gmail / Standard SMTP) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
FRONTEND_URL=http://localhost:3000

# ---- Encryption (generate with: python -c "import secrets; print(secrets.token_hex(32))") ----
# CAUTION: Keep this secret. Never commit to git. Losing it means stored API keys are unrecoverable.
SECRET_KEY=YOUR_64_CHAR_HEX_SECRET_HERE

# ---- Auth Service RSA Key (SEC-04 fix) ----
# Generate with: openssl genrsa 2048 2>/dev/null | base64 -w 0
# Then paste the output as the value. Add to Render's Secret environment variables.
RSA_PRIVATE_KEY=YOUR_BASE64_ENCODED_RSA_PRIVATE_KEY_HERE

# ---- Internal Service Secret (SEC-08 fix) ----
# Shared between core-service and gateway to authenticate /internal/notify calls.
# Generate with: openssl rand -hex 32
INTERNAL_SECRET=YOUR_64_CHAR_HEX_SECRET_HERE
